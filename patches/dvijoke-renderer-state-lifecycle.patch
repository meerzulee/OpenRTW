+            case TexFormat::RGB565:
+            case TexFormat::RGBA4:
+            case TexFormat::RGB5A1:
+            case TexFormat::A8L8: return pixels * 2;
+            case TexFormat::L8: return pixels;
+            case TexFormat::DXT1: return ((uint64_t(width) + 3) / 4) * ((uint64_t(height) + 3) / 4) * 8;
+            case TexFormat::DXT3:
+            case TexFormat::DXT5: return ((uint64_t(width) + 3) / 4) * ((uint64_t(height) + 3) / 4) * 16;
+        }
+        return 0;
+    }
