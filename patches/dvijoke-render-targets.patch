+    bool padTargetForPrimaryDepth(BackendHandle handle) {
+        // WebGL2 requires identical attachment sizes, while D3D8 permits a
+        // larger depth surface. Preserve the logical color rectangle in a
+        // padded physical RGB8 texture, using a real GPU blit before commit.
+        auto& target = m_targets[handle - 1];
+        GLint oldRead, oldDraw, oldTexture;
+        glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &oldRead); glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &oldDraw);
+        glGetIntegerv(GL_TEXTURE_BINDING_2D, &oldTexture);
+        const GLboolean scissor = glIsEnabled(GL_SCISSOR_TEST);
+        GLuint framebuffer = 0, color = 0;
+        glGenFramebuffers(1, &framebuffer); glGenTextures(1, &color);
+        glBindTexture(GL_TEXTURE_2D, color); glTexStorage2D(GL_TEXTURE_2D, 1, GL_RGB8, m_width, m_height);
+        glBindFramebuffer(GL_FRAMEBUFFER, framebuffer);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, color, 0);
+        glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_STENCIL_ATTACHMENT, GL_RENDERBUFFER, m_backbufferDepth);
+        bool complete = glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+        GLenum error = glGetError();
+        if (complete && error == GL_NO_ERROR) {
+            glDisable(GL_SCISSOR_TEST);
+            glBindFramebuffer(GL_READ_FRAMEBUFFER, target.framebuffer);
+            glBindFramebuffer(GL_DRAW_FRAMEBUFFER, framebuffer);
+            glBlitFramebuffer(0, 0, target.width, target.height, 0, 0, target.width, target.height,
+                              GL_COLOR_BUFFER_BIT, GL_NEAREST);
+            error = glGetError();
+        }
+        if (scissor) glEnable(GL_SCISSOR_TEST); else glDisable(GL_SCISSOR_TEST);
+        if (!framebuffer || !color || !complete || error != GL_NO_ERROR) {
+            glBindFramebuffer(GL_READ_FRAMEBUFFER, GLuint(oldRead)); glBindFramebuffer(GL_DRAW_FRAMEBUFFER, GLuint(oldDraw));
+            glBindTexture(GL_TEXTURE_2D, GLuint(oldTexture));
+            glDeleteFramebuffers(1, &framebuffer); glDeleteTextures(1, &color);
+            fail("Render target padding for shared depth failed"); return false;
+        }
+        const GLuint oldFramebuffer = target.framebuffer, oldColor = target.color;
+        target.framebuffer = framebuffer; target.color = color;
+        target.storageWidth = UINT(m_width); target.storageHeight = UINT(m_height); target.primaryDepth = true;
+        glBindFramebuffer(GL_READ_FRAMEBUFFER, GLuint(oldRead) == oldFramebuffer ? framebuffer : GLuint(oldRead));
+        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, GLuint(oldDraw) == oldFramebuffer ? framebuffer : GLuint(oldDraw));
+        glBindTexture(GL_TEXTURE_2D, GLuint(oldTexture) == oldColor ? color : GLuint(oldTexture));
+        glDeleteFramebuffers(1, &oldFramebuffer); glDeleteTextures(1, &oldColor);
+        return true;
+    }
